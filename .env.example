# Copy to .env and fill in. Never commit .env.

# --- Alerting -------------------------------------------------------------
# Phase 0 ships two channels; enable either or both.
ALERT_CHANNELS=telegram,email        # comma separated: telegram | email

# Telegram: create a bot with @BotFather, then message it once and read your
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email: an app-specific password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- Extraction -----------------------------------------------------------
# Phase 0 uses the built-in regex extractor regardless of this setting.
# Phase 2 wires the LLM backends behind it.
EXTRACTOR_BACKEND=claude             # claude | ollama | none
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Thresholds (Phase 2/3) ----------------------------------------------
ALERT_MIN_RELEVANCE=40
MIN_CONFIDENCE=0.35

# --- Fetching -------------------------------------------------------------
# Goes into the User-Agent so site owners can contact you. Please set it.
CONTACT_EMAIL=
DB_PATH=data/radar.db

# --- Interview drill agent (`prep`) --------------------------------------
# Reuses TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID above — same bot, same chat.

# Question writing and grading. With no key the agent still runs every day off
# the seeded bank in config/topics.yml and grades on answer-key coverage.
PREP_MODEL=claude-sonnet-5
# Force a backend regardless of the key: claude | bank
PREP_GENERATOR=claude
# claude | heuristic
PREP_GRADER=claude

PREP_DB_PATH=data/prep.db
# Defaults to `config`; only set this if you keep profile.yml elsewhere.
# PREP_CONFIG_DIR=config
